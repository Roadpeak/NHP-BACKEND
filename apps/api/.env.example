# Owner connection — migrations and hardening ONLY. Never used by the app.
DATABASE_URL="postgresql://nhp_owner:nhp_dev_password@localhost:5434/nhp?schema=public"

# Application connection — no UPDATE/DELETE on clinical tables.
APP_DATABASE_URL="postgresql://nhp_app:nhp_app_dev_password@localhost:5434/nhp?schema=public"

# Analyst connection — aggregates only, zero clinical grants.
ANALYST_DATABASE_URL="postgresql://nhp_analyst:nhp_analyst_dev_password@localhost:5434/nhp?schema=public"

# Blind-index pepper. In production this lives in a KMS, never in a file.
BLIND_INDEX_PEPPER="dev_only_pepper_change_me"

# Role passwords — read by harden.ts, never hardcoded in SQL.
# Change these before any deployment; use a secret manager in production.
APP_ROLE_PASSWORD="nhp_app_dev_password"
AUDIT_WRITER_ROLE_PASSWORD="nhp_audit_dev_password"
AUDITOR_ROLE_PASSWORD="nhp_auditor_dev_password"
ANALYST_ROLE_PASSWORD="nhp_analyst_dev_password"

# Field encryption key. Derived via scrypt, so length is flexible.
# Production: KMS. Rotating this makes existing ciphertext unreadable.
FIELD_ENCRYPTION_KEY="dev_only_field_key_change_me"

PORT=4400

# Which browser origins may call this API, comma-separated. Defaults to
# http://localhost:3100 — the frontend in development. MUST be set to the
# real frontend origin in any deployment: leaving the default means the
# deployed browser app is refused by CORS and every request fails.
CORS_ORIGIN="http://localhost:3100"

# Pino log level: trace | debug | info | warn | error | fatal. Defaults to
# info. Note that debug and trace echo request bodies, which on this API
# means patient data in the log — do not enable them in production.
LOG_LEVEL="info"

# development | production | test. In production the server REFUSES to
# start without real SMS credentials, and does not register the test hooks
# at all, rather than printing sign-in codes to a log.
NODE_ENV="development"

# JWT signing secret, minimum 32 characters. Production: KMS.
JWT_SECRET="change_me_to_at_least_32_characters_long"

# Africa's Talking. Without these the console provider is used in
# development; in production the server REFUSES to start rather than print
# codes to a log instead of sending them.
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# Test hooks (development only). Must be >= 32 chars, or the hook refuses
# to run. Leave unset to disable. Never set this in production.
TEST_HOOK_SECRET=""
