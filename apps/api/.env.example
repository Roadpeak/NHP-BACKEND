# Owner connection — migrations and hardening ONLY. Never used by the app.
DATABASE_URL="postgresql://nhp_owner:nhp_dev_password@localhost:5434/nhp?schema=public"

# Application connection — no UPDATE/DELETE on clinical tables.
APP_DATABASE_URL="postgresql://nhp_app:nhp_app_dev_password@localhost:5434/nhp?schema=public"

# Analyst connection — aggregates only, zero clinical grants.
ANALYST_DATABASE_URL="postgresql://nhp_analyst:nhp_analyst_dev_password@localhost:5434/nhp?schema=public"

# Blind-index pepper. In production this lives in a KMS, never in a file.
BLIND_INDEX_PEPPER="dev_only_pepper_change_me"
