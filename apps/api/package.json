{
  "name": "@nhp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "prisma migrate dev --name init --skip-seed",
    "migrate:deploy": "prisma migrate deploy",
    "deploy": "prisma migrate deploy && tsx src/harden.ts",
    "generate": "prisma generate",
    "harden": "tsx src/harden.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "studio": "prisma studio",
    "serve": "tsx watch src/server.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "demo:reset": "tsx src/seed-demo.ts --reset",
    "dev:code": "tsx src/dev-code.ts",
    "ministry:bootstrap": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "otpauth": "^9.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
