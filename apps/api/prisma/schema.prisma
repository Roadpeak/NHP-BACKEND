enum GrantBy {
  PATIENT
  GUARDIAN
  COURT_ORDER
}

enum GrantMethod {
  IN_PERSON_OTP
  PORTAL
  VERBAL_ATTESTED
}

enum ActorKind {
  PRACTITIONER
  FACILITY_ADMIN
  MINISTRY
  PATIENT
  GUARDIAN
  SYSTEM
}

enum Action {
  SEARCH
  VIEW_SUMMARY
  VIEW_RECORD
  WRITE
  EXPORT
  PRINT
  BREAK_GLASS
}

enum AccessReason {
  ACTIVE_CONSULTATION
