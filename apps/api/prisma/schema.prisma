  GUARDIAN
  COURT_ORDER
}

enum GrantMethod {
  IN_PERSON_OTP
  PORTAL
  VERBAL_ATTESTED
}

enum ActorKind {
  PRACTITIONER
  FACILITY_ADMIN
  MINISTRY
  PATIENT
  GUARDIAN
  SYSTEM
}

enum Action {
