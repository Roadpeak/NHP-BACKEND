// NHP — National Health Portal
// Phase 0 schema. Structure only; the guarantees live in prisma/sql/*.sql,
// which is applied by `pnpm harden` after migration.
//
// Reading notes:
//   - Clinical models carry the "clinical stamp": personId, checkInId,
//     recordedBy, facilityId, licenceNumber, recordedAt. None nullable.
//   - Clinical + audit models are APPEND-ONLY. The app role holds no
//     UPDATE/DELETE grant on them. See harden.sql.
//   - Identifiers are encrypted at rest with a blind index for lookup.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ---------------------------------------------------------------- enums

enum Sex {
  MALE
  FEMALE
  INTERSEX
}

enum Precision {
  EXACT
  MONTH
  YEAR
  ESTIMATED
}

enum LifeStatus {
  ALIVE
  DECEASED
  INACTIVE
  EMIGRATED
}

enum Maturity {
  DEPENDANT
  PENDING_PROMOTION
  ADULT
}

enum RegRoute {
  SELF
  FACILITY_BIRTH
  GUARDIAN
  MINISTRY
}

enum VerState {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum IdType {
  NATIONAL_ID
  BIRTH_CERT
  PASSPORT
  ALIEN_ID
  UNHCR
  HUDUMA
  MILITARY
  PROVISIONAL
}

enum IdStatus {
  ACTIVE
  SUPERSEDED
  DISPUTED
  REVOKED
}

enum Relation {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  FOSTER
  INSTITUTION
  OTHER
}

enum Evidence {
  BIRTH_RECORD
  BIRTH_CERT
  COURT_ORDER
  FACILITY_ATTESTED
  SELF_DECLARED
}

enum GuardStatus {
  ACTIVE
  ENDED
  DISPUTED
  REVOKED
}

enum AcctStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

enum MfaMode {
  NONE
  SMS
  TOTP
}

enum SubKind {
  HEALTH_ADMIN
  CONSTITUENCY
  BOTH
}

enum Ownership {
  PUBLIC_MOH
  PUBLIC_OTHER
  PRIVATE_FOR_PROFIT
  FAITH_BASED
  NGO
}

enum FacStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CapDomain {
  SERVICE
  DIAGNOSTIC
  EQUIPMENT
  SPECIALTY
}

enum Avail {
  ROUTINE
  BUSINESS_HOURS
  ON_CALL
  REFERRAL_ONLY
}

enum CapStatus {
  CLAIMED
  VERIFIED
  SUSPENDED
}

enum Cadre {
  DOCTOR
  DENTIST
  CLINICAL_OFFICER
  NURSE
  MIDWIFE
  PHARMACIST
  LAB_TECH
  RADIOGRAPHER
  NUTRITIONIST
  PSYCHOLOGIST
  CHW
}

enum Regulator {
  KMPDC
  NCK
  COC
  PPB
  KMLTTB
  KNDI
}

enum PracStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
  REVOKED
}

enum LicStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum FacRole {
  ATTENDING
  RESIDENT
  VISITING
  LOCUM
  FACILITY_ADMIN
}

enum GrantKind {
  FACILITY
  MINISTRY
}

enum AffStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum EndReason {
  MANUAL
  EXPIRED
  REVOKED
  FACILITY_CLOSED
}

enum CheckMethod {
  SELF_SELECT
  FACILITY_CODE
  GEOFENCE
}

enum Tier {
  TIER_1_EMERGENCY
  TIER_2_GENERAL
  TIER_3_RESTRICTED
}

enum EncKind {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  MATERNITY
  IMMUNISATION
  SCREENING
  FOLLOW_UP
  TELEHEALTH
}

enum Band {
  RED
  ORANGE
  YELLOW
  GREEN
}

enum Disposition {
  DISCHARGED
  ADMITTED
  REFERRED
  ABSCONDED
  DIED
  LEFT_AGAINST_ADVICE
}

enum CondStatus {
