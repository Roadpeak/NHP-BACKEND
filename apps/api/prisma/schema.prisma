  @@index([therapeuticClass])
  @@index([allergyClass])
  @@map("medication_term")
}

/// Paediatric dosing by weight band.
///
/// Some medicines are not dosed per kilogram at all. Artemether-lumefantrine
/// and the anti-TB fixed-dose combinations come as whole dispersible tablets
/// and are dispensed against a published band table, because a health worker
/// counting tablets in a busy clinic cannot be asked to compute a mg/kg dose
/// and then round it to a tablet fraction.
///
/// Bands are half-open — `minKg <= weight < maxKg` — and the seed validator
/// refuses any drug whose bands leave a gap or overlap. A gap means a child
/// of that weight gets no dose; an overlap means they match two. Both are
/// answered before the data is allowed anywhere near a prescriber.
model MedicationWeightBand {
  id       String @id @default(uuid(7))
  kemlCode String @map("keml_code")

  /// Inclusive lower bound.
  minKg Decimal @map("min_kg") @db.Decimal(5, 2)
  /// Exclusive upper bound. The heaviest band carries a catch-all ceiling so
  /// no adolescent falls off the end of the table.
  maxKg Decimal @map("max_kg") @db.Decimal(5, 2)

  doseAmount   Decimal @map("dose_amount") @db.Decimal(8, 3)
  doseUnit     String  @map("dose_unit")
  doseForm     String  @map("dose_form")
  frequency    String
  durationDays Int?    @map("duration_days")
  notes        String?

  @@unique([kemlCode, minKg])
  @@index([kemlCode])
  @@map("medication_weight_band")
}

model AllergyClassTerm {
  id              String   @id @default(uuid(7))
  allergyClass    String   @unique @map("allergy_class")
  labelEn         String   @map("label_en")
  labelSw         String   @map("label_sw")
  crossReactsWith String[] @map("cross_reacts_with")
  severityDefault Severity @map("severity_default")
  alternatives    String[]
  clinicalNote    String?  @map("clinical_note")
  reviewStatus    String   @map("review_status")

  @@map("allergy_class_term")
}

// -------------------------------------------------------------- auth

/// A refresh token, one per device.
///
/// Stored hashed: a database dump must not yield working sessions. Rotated
/// on every use, so a stolen token is usable at most once — and reuse of an
/// already-rotated token means theft, which revokes the whole family.
model RefreshToken {
  id         String    @id @default(uuid(7))
  accountId  String    @map("account_id")
  account    Account   @relation(fields: [accountId], references: [id])
  tokenHash  String    @unique @map("token_hash")
  /// Tokens rotated from the same original share a family id.
  familyId   String    @map("family_id")
  deviceHint String?   @map("device_hint")
  ipHash     String?   @map("ip_hash")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedFor String?   @map("revoked_for")

  @@index([accountId, revokedAt])
  @@index([familyId])
  @@map("refresh_token")
}

/// A one-time code, for phone verification and SMS second factors.
model OtpChallenge {
  id         String    @id @default(uuid(7))
  accountId  String?   @map("account_id")
  /// Blind index of the phone, so an unregistered number can still be sent one.
  phoneIndex String    @map("phone_index")
  codeHash   String    @map("code_hash")
  purpose    String
  attempts   Int       @default(0)
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([phoneIndex, purpose, expiresAt])
  @@map("otp_challenge")
}

// ------------------------------------------------- offline sync (P9)

enum SyncStatus {
  QUEUED
  APPLIED
  CONFLICT
  REJECTED
}

/// A write made while a facility was offline.
///
/// Connectivity in Level 2 and 3 facilities is genuinely unreliable. If NHP
/// only works online, clinicians keep the paper register and enter data
/// later or not at all — and the record becomes untrustworthy.
model SyncEnvelope {
  id             String     @id @default(uuid(7))
  /// Client-generated. The same envelope replayed twice must apply once.
  idempotencyKey String     @unique @map("idempotency_key")
  deviceId       String     @map("device_id")
  practitionerId String     @map("practitioner_id")
  facilityId     String     @map("facility_id")
  checkInId      String     @map("check_in_id")
  operation      String
  payload        Json
  /// When the clinician actually did it, not when it reached the server.
  occurredAt     DateTime   @map("occurred_at")
  receivedAt     DateTime   @default(now()) @map("received_at")
  status         SyncStatus @default(QUEUED)
  appliedAt      DateTime?  @map("applied_at")
  resultId       String?    @map("result_id")
  rejectionCode  String?    @map("rejection_code")
  rejectionNote  String?    @map("rejection_note")

  @@index([status, receivedAt])
  @@index([deviceId, occurredAt])
  @@map("sync_envelope")
}

// ------------------------------------------------------ referral (P8)

enum Urgency {
  EMERGENCY
  URGENT_24H
  SOON_7D
  ROUTINE
}

enum RefStatus {
  ISSUED
  ACCEPTED
  DECLINED
  ARRIVED
  COMPLETED
  EXPIRED
  CANCELLED
}

model Referral {
  id                   String    @id @default(uuid(7))
  personId             String    @map("person_id")
  fromFacilityId       String    @map("from_facility_id")
  fromEncounterId      String    @map("from_encounter_id")
  referredBy           String    @map("referred_by")
  /// Null for an open referral — "any facility that can do this".
  toFacilityId         String?   @map("to_facility_id")
  toSpecialty          String?   @map("to_specialty")
  urgency              Urgency
  reason               String
  requiredCapabilities String[]  @map("required_capabilities")
  status               RefStatus @default(ISSUED)
  issuedAt             DateTime  @default(now()) @map("issued_at")
  expiresAt            DateTime  @map("expires_at")
  respondedAt          DateTime? @map("responded_at")
  respondedBy          String?   @map("responded_by")
  declineReason        String?   @map("decline_reason")
  arrivedAt            DateTime? @map("arrived_at")
  arrivalEncounterId   String?   @map("arrival_encounter_id")
  cancelledReason      String?   @map("cancelled_reason")

  counterReferral CounterReferral?

  @@index([personId, issuedAt])
  @@index([toFacilityId, status])
  @@index([fromFacilityId, issuedAt])
  @@index([status, expiresAt])
  @@map("referral")
}

/// The part every system forgets: telling the referring clinician what
/// happened. Without it a referral is a one-way message, not care.
model CounterReferral {
  id            String   @id @default(uuid(7))
  referralId    String   @unique @map("referral_id")
  referral      Referral @relation(fields: [referralId], references: [id])
  summary       String
  outcomeCode   String?  @map("outcome_code")
  followUpPlan  String?  @map("follow_up_plan")
  returnedBy    String   @map("returned_by")
  returnedAt    DateTime @default(now()) @map("returned_at")
  facilityId    String   @map("facility_id")
  licenceNumber String   @map("licence_number")

  @@map("counter_referral")
}

// -------------------------------------------------------- triage (P6)

model SymptomTerm {
