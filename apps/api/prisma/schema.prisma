// NHP — National Health Portal
// Phase 0 schema. Structure only; the guarantees live in prisma/sql/*.sql,
// which is applied by `pnpm harden` after migration.
//
// Reading notes:
//   - Clinical models carry the "clinical stamp": personId, checkInId,
//     recordedBy, facilityId, licenceNumber, recordedAt. None nullable.
//   - Clinical + audit models are APPEND-ONLY. The app role holds no
//     UPDATE/DELETE grant on them. See harden.sql.
//   - Identifiers are encrypted at rest with a blind index for lookup.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

