  DOCTOR
  DENTIST
  CLINICAL_OFFICER
  NURSE
  MIDWIFE
  PHARMACIST
  LAB_TECH
  RADIOGRAPHER
  NUTRITIONIST
  PSYCHOLOGIST
  CHW
}

enum Regulator {
  KMPDC
  NCK
  COC
  PPB
  KMLTTB
  KNDI
}

enum PracStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RETIRED
  REVOKED
}

enum LicStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum FacRole {
  ATTENDING
  RESIDENT
  VISITING
  LOCUM
  FACILITY_ADMIN
}

enum GrantKind {
  FACILITY
  MINISTRY
}

enum AffStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

/// What a director is to the facility they run.
enum DirectorRole {
  /// Owns it. Usually the person whose National ID is on the ownership
  /// evidence, and usually not a clinician.
  OWNER
  /// Runs it day to day. A public facility's Ministry-posted manager, or a
  /// private one's appointed director.
  DIRECTOR
  /// Delegated administration without ownership.
  MANAGER
}

enum DirectorStatus {
  /// Named at registration, not yet real. Nobody administers a facility the
  /// Ministry has not verified.
  PENDING
  ACTIVE
  ENDED
}

/// Who appointed a director — themselves at registration, or the Ministry.
enum AppointedByKind {
  SELF
  MINISTRY
}

enum EndReason {
  MANUAL
  EXPIRED
  REVOKED
  FACILITY_CLOSED
}

enum CheckMethod {
  SELF_SELECT
  FACILITY_CODE
  GEOFENCE
}

enum Tier {
  TIER_1_EMERGENCY
  TIER_2_GENERAL
  TIER_3_RESTRICTED
}

enum EncKind {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  MATERNITY
  IMMUNISATION
  SCREENING
  FOLLOW_UP
  TELEHEALTH
}

enum Band {
  RED
  ORANGE
  YELLOW
  GREEN
}

