}

// ------------------------------------------------------------ geography

model County {
  id      String      @id @default(uuid(7))
  code    String      @unique
  name    String
  subs    SubCounty[]
  persons Person[]
  facils  Facility[]

  @@map("county")
}

model SubCounty {
  id       String     @id @default(uuid(7))
  countyId String     @map("county_id")
  county   County     @relation(fields: [countyId], references: [id])
  name     String
  kind     SubKind    @default(HEALTH_ADMIN)
  wards    Ward[]
  persons  Person[]
  facils   Facility[]

  @@index([countyId])
  @@map("subcounty")
}

model Ward {
  id          String    @id @default(uuid(7))
  subcountyId String    @map("subcounty_id")
  subcounty   SubCounty @relation(fields: [subcountyId], references: [id])
  name        String

  @@index([subcountyId])
  @@map("ward")
}

// ------------------------------------------------------------- identity

model Person {
  id                String             @id @default(uuid(7))
  displayNumber     String             @unique @map("display_number")
  givenName         String             @map("given_name")
  middleName        String?            @map("middle_name")
  familyName        String             @map("family_name")
  sexAtBirth        Sex                @map("sex_at_birth")
  dateOfBirth       DateTime           @map("date_of_birth") @db.Date
  dobPrecision      Precision          @default(EXACT) @map("dob_precision")
  bloodGroup        BloodGroup?        @map("blood_group")
  /**
   * Passport photo, encrypted at rest like every other identifier.
   * A face is biometric data under the Data Protection Act, so it gets the
   * same AES-256-GCM treatment as a National ID rather than a public URL —
   * there is no object store to leak from and nothing a CDN can cache.
   */
  photo             String?            @map("photo_enc")
  arrivals          Arrival[]
  directorships     FacilityDirector[]
  lifeStatus        LifeStatus         @default(ALIVE) @map("life_status")
  deceasedAt        DateTime?          @map("deceased_at")
  countyId          String             @map("county_id")
  county            County             @relation(fields: [countyId], references: [id])
  subcountyId       String             @map("subcounty_id")
  subcounty         SubCounty          @relation(fields: [subcountyId], references: [id])
  wardId            String?            @map("ward_id")
  residenceNote     String?            @map("residence_note")
  maturity          Maturity           @default(ADULT)
  registeredBy      String             @map("registered_by")
  registrationRoute RegRoute           @map("registration_route")
  verificationState VerState           @default(UNVERIFIED) @map("verification_state")
  mergedIntoId      String?            @map("merged_into_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  identifiers  Identifier[]
  account      Account?
  asDependant  Guardianship[] @relation("dependant")
  asGuardian   Guardianship[] @relation("guardian")
  practitioner Practitioner?
  ministryUser MinistryUser?
  encounters   Encounter[]
  conditions   Condition[]
  allergies    Allergy[]
  medications  Medication[]
  observations Observation[]
  procedures   Procedure[]
  consents     ConsentGrant[]

  @@index([countyId, subcountyId])
  @@index([maturity, dateOfBirth])
  @@map("person")
}

model Identifier {
  id          String    @id @default(uuid(7))
  personId    String    @map("person_id")
  person      Person    @relation(fields: [personId], references: [id])
  type        IdType
  value       String
  valueIndex  String    @map("value_index")
  issuedOn    DateTime? @map("issued_on") @db.Date
  verifiedAt  DateTime? @map("verified_at")
  verifiedVia String?   @map("verified_via")
  status      IdStatus  @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([personId, type])
  @@index([valueIndex])
  @@map("identifier")
}

model Guardianship {
  id            String      @id @default(uuid(7))
  dependantId   String      @map("dependant_id")
  dependant     Person      @relation("dependant", fields: [dependantId], references: [id])
  guardianId    String      @map("guardian_id")
  guardian      Person      @relation("guardian", fields: [guardianId], references: [id])
  relationship  Relation
  isPrimary     Boolean     @default(false) @map("is_primary")
  establishedBy String      @map("established_by")
  evidence      Evidence
  status        GuardStatus @default(ACTIVE)
  startedAt     DateTime    @default(now()) @map("started_at")
  endedAt       DateTime?   @map("ended_at")
  endReason     String?     @map("end_reason")

  @@index([guardianId, status])
  @@index([dependantId, status])
  @@map("guardianship")
}

model Account {
  id              String     @id @default(uuid(7))
  personId        String?    @unique @map("person_id")
  person          Person?    @relation(fields: [personId], references: [id])
  practitionerId  String?    @unique @map("practitioner_id")
  ministryUserId  String?    @unique @map("ministry_user_id")
  /**
   * What this account signs in WITH. For a citizen that is their phone; for
   * a clinician it is their licence number, because the phone already
   * belongs to their own citizen account and one number cannot key two.
   */
  phone           String
  phoneIndex      String     @unique @map("phone_index")
  /**
   * Where security codes are SENT.
   * Separate from `phone` because that column doubles as the sign-in
   * identifier: a clinician keyed on a licence number would otherwise have
   * codes texted to a number derived from that licence — one nobody owns.
   * Null means "use `phone`", which is correct for every citizen.
   */
  smsPhone        String?    @map("sms_phone")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  email           String?
  emailIndex      String?    @map("email_index")
  passwordHash    String     @map("password_hash")
  passwordSetAt   DateTime   @default(now()) @map("password_set_at")
  mfaMode         MfaMode    @default(NONE) @map("mfa_mode")
  mfaSecret       String?    @map("mfa_secret")
  status          AcctStatus @default(ACTIVE)
  failedAttempts  Int        @default(0) @map("failed_attempts")
  lockedUntil     DateTime?  @map("locked_until")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([emailIndex])
  @@map("account")
}

// ------------------------------------------------------------ facility

model Facility {
  id                 String    @id @default(uuid(7))
  mflCode            String?   @unique @map("mfl_code")
  name               String
  kephLevel          Int       @map("keph_level")
  ownership          Ownership
  countyId           String    @map("county_id")
  county             County    @relation(fields: [countyId], references: [id])
  subcountyId        String    @map("subcounty_id")
  subcounty          SubCounty @relation(fields: [subcountyId], references: [id])
  wardId             String?   @map("ward_id")
  locality           String
  latitude           Float
  longitude          Float
  operatingHours     Json?     @map("operating_hours")
  is24Hour           Boolean   @default(false) @map("is_24_hour")
  bedCapacity        Int?      @map("bed_capacity")
  icuBeds            Int?      @map("icu_beds")
  maternityBeds      Int?      @map("maternity_beds")
  /**
   * How the facility itself is reached — not whoever registered it.
   * A registrar has to be able to ask about the ownership evidence before
   * approving, and a referral has to reach the place it names. Neither of
   * those is served by the registrant's personal number.
   */
  phone              String?
  email              String?
  registrationStatus FacStatus @default(PENDING) @map("registration_status")
  licensedUntil      DateTime? @map("licensed_until") @db.Date
  /**
   * Ownership evidence for a private facility.
   * Reference numbers, not scans: a registrar checks these against the
   * Business Registry, KRA and the MOH register, which is stronger than a
   * document someone uploaded. Null for a public facility, which the
   * Ministry itself creates.
   */
  businessRegNo      String?   @map("business_reg_no")
  kraPin             String?   @map("kra_pin")
  practiceLicenceNo  String?   @map("practice_licence_no")
  /**
   * Encrypted, like every other National ID in the system.
   */
  ownerNationalId    String?   @map("owner_national_id")
  ownerName          String?   @map("owner_name")

  /// Who becomes the first FACILITY_ADMIN once a registrar approves this
  /// facility. Held here rather than as an affiliation because an
  /// affiliation to a PENDING facility is refused by design — nobody
  /// administers a facility the Ministry has not yet verified.
  pendingAdminPractitionerId String? @map("pending_admin_practitioner_id")

  /// Who becomes the first DIRECTOR once a registrar approves this facility.
  ///
  /// Separate from the practitioner above because a hospital owner is
  /// usually a businessperson, not a clinician. Requiring a KMPDC licence
  /// to register a facility you own excluded the people who actually own
  /// most private hospitals in Kenya.
  pendingDirectorPersonId String? @map("pending_director_person_id")

  /// Who approved this facility, and when. `approveFacility` took a
  /// ministryUserId and discarded it, so an approval was unattributable —
  /// the one decision in the system that turns unverified ownership
  /// paperwork into a facility that can reach patient records.
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  capabilities FacilityCapability[]
  affiliations Affiliation[]
  checkIns     CheckIn[]
  arrivals     Arrival[]
  directors    FacilityDirector[]

  @@index([countyId, kephLevel, registrationStatus])
  @@index([name])
  @@map("facility")
}

model Capability {
  id           String    @id @default(uuid(7))
  code         String    @unique
  labelEn      String    @map("label_en")
  labelSw      String    @map("label_sw")
  domain       CapDomain
  minKephLevel Int?      @map("min_keph_level")

  facilities FacilityCapability[]

  @@map("capability")
}

model FacilityCapability {
  id              String     @id @default(uuid(7))
  facilityId      String     @map("facility_id")
  facility        Facility   @relation(fields: [facilityId], references: [id])
  capabilityId    String     @map("capability_id")
  capability      Capability @relation(fields: [capabilityId], references: [id])
  availability    Avail      @default(ROUTINE)
  status          CapStatus  @default(CLAIMED)
  verifiedBy      String?    @map("verified_by")
  verifiedAt      DateTime?  @map("verified_at")
  lastConfirmedAt DateTime   @default(now()) @map("last_confirmed_at")

  @@unique([facilityId, capabilityId])
  @@index([capabilityId])
  @@map("facility_capability")
}

// -------------------------------------------------------- practitioner

model Practitioner {
  id          String     @id @default(uuid(7))
  personId    String     @unique @map("person_id")
  person      Person     @relation(fields: [personId], references: [id])
  cadre       Cadre
  countyId    String     @map("county_id")
  subcountyId String     @map("subcounty_id")
  status      PracStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  licences     Licence[]
  affiliations Affiliation[]
  checkIns     CheckIn[]

  @@map("practitioner")
}

model Licence {
  id             String       @id @default(uuid(7))
  practitionerId String       @map("practitioner_id")
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  regulator      Regulator
  licenceNumber  String       @map("licence_number")
  issuedOn       DateTime     @map("issued_on") @db.Date
  expiresOn      DateTime     @map("expires_on") @db.Date
  scope          String?
  verifiedAt     DateTime?    @map("verified_at")
  verifiedVia    String?      @map("verified_via")
  status         LicStatus    @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([regulator, licenceNumber])
  @@index([practitionerId])
  @@index([expiresOn])
  @@map("licence")
}

/// Who runs a facility.
///
/// Deliberately NOT an Affiliation. `Affiliation.practitionerId` is
/// non-nullable and drives the clinical check-in gate and the append-only
/// triggers: making it nullable so it could hold a director would weaken the
/// guarantee that every clinical write cites a licensed practitioner.
///
/// A director is a Person, which means they already have an account, a
/// password they chose and a phone for their second factor — and it means
/// authentication needed no new owner kind, so `account_one_owner_ck` is
/// untouched. A director who IS a clinician is linked through the Person
/// behind their practitioner record, so one human stays one identity.
///
/// The facility deliberately has no password of its own. A shared credential
/// walks out with whoever leaves, and every action taken through it would be
/// attributable to "the facility" rather than a person.
model FacilityDirector {
  id         String   @id @default(uuid(7))
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id])
  personId   String   @map("person_id")
  person     Person   @relation(fields: [personId], references: [id])

  role   DirectorRole   @default(DIRECTOR)
  status DirectorStatus @default(PENDING)

  /// Attributed, like every other grant in the system. A director who
  /// appointed themselves at registration is a different fact from one the
  /// Ministry posted, and an approval nobody is answerable for is the one
  /// thing this register cannot afford.
  appointedBy     String          @map("appointed_by")
  appointedByKind AppointedByKind @map("appointed_by_kind")

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// One person holds one directorship per facility. A second row would let
  /// an ENDED appointment sit beside an ACTIVE one for the same human.
  @@unique([facilityId, personId])
  @@index([facilityId, status])
  @@index([personId, status])
  @@map("facility_director")
}

model Affiliation {
  id             String       @id @default(uuid(7))
  practitionerId String       @map("practitioner_id")
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  facilityId     String       @map("facility_id")
  facility       Facility     @relation(fields: [facilityId], references: [id])
  role           FacRole      @default(ATTENDING)
  grantedBy      String       @map("granted_by")
  grantedByKind  GrantKind    @map("granted_by_kind")
  status         AffStatus    @default(ACTIVE)
  startedAt      DateTime     @default(now()) @map("started_at")
  endedAt        DateTime?    @map("ended_at")

  checkIns CheckIn[]

  @@index([practitionerId, status])
  @@index([facilityId, status])
  @@map("affiliation")
}

model CheckIn {
  id             String       @id @default(uuid(7))
  practitionerId String       @map("practitioner_id")
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  facilityId     String       @map("facility_id")
  facility       Facility     @relation(fields: [facilityId], references: [id])
  affiliationId  String       @map("affiliation_id")
  affiliation    Affiliation  @relation(fields: [affiliationId], references: [id])
  startedAt      DateTime     @default(now()) @map("started_at")
  expiresAt      DateTime     @map("expires_at")
  endedAt        DateTime?    @map("ended_at")
  endReason      EndReason?   @map("end_reason")
  method         CheckMethod  @default(SELF_SELECT)
  deviceHint     String?      @map("device_hint")
  ipHash         String?      @map("ip_hash")

  encounters   Encounter[]
  conditions   Condition[]
  allergies    Allergy[]
  medications  Medication[]
  observations Observation[]
  procedures   Procedure[]

  @@index([practitionerId, endedAt])
  @@index([facilityId, startedAt])
  @@map("check_in")
}

// ------------------------------------------------------- clinical core
// Every model below is APPEND-ONLY. See prisma/sql/harden.sql.

/// Someone has arrived and is waiting to be seen.
///
/// Deliberately NOT an Encounter. An Encounter is append-only clinical
/// data, requires an open check-in and a licence number, and is written by
/// a clinician. Arriving at a reception desk is none of those things: it
/// is an administrative fact that gets amended (people leave, get
/// redirected, are added twice) and is recorded by someone with no licence.
///
/// Keeping the waiting room out of the clinical tables is what allows
/// reception to write here at all.
model Arrival {
  id         String   @id @default(uuid(7))
  personId   String   @map("person_id")
  person     Person   @relation(fields: [personId], references: [id])
  facilityId String   @map("facility_id")
  facility   Facility @relation(fields: [facilityId], references: [id])

  arrivedAt    DateTime @default(now()) @map("arrived_at")
  /// Free text in the person's own words. Reception is not triaging and
  /// must not be invited to: this is "chest pain since Tuesday", not a
  /// diagnosis, and it is never treated as one.
  statedReason String?  @map("stated_reason")

  status       ArrivalStatus @default(WAITING)
  /// The practitioner who took them through. Set when an encounter opens.
  seenById     String?       @map("seen_by_id")
  closedAt     DateTime?     @map("closed_at")
  /// Who registered the arrival — reception, or a clinician working the
  /// desk at a small dispensary where there is no separate reception.
  registeredBy String        @map("registered_by")

  @@index([facilityId, status, arrivedAt])
  @@index([personId, arrivedAt])
  @@map("arrival")
}

enum ArrivalStatus {
  WAITING
  IN_CONSULTATION
  /// Seen and finished.
  COMPLETED
  /// Went home, or was sent elsewhere, without being seen.
  LEFT
}

