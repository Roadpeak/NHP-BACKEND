model MedicationTerm {
  id                String   @id @default(uuid(7))
  kemlCode          String   @unique @map("keml_code")
  genericName       String   @map("generic_name")
  plainEn           String   @map("plain_en")
  plainSw           String   @map("plain_sw")
  form              String
  strength          String
  route             Route
  therapeuticClass  String   @map("therapeutic_class")
  minKephLevel      Int      @map("min_keph_level")
  adultDose         String   @map("adult_dose")
  adultFreq         String   @map("adult_freq")
  adultDurationDays Int?     @map("adult_duration_days")
  paedDoseMgPerKg   Decimal? @map("paed_dose_mg_per_kg") @db.Decimal(10, 3)
  paedDosingMode    String   @map("paed_dosing_mode")
  maxDailyMg        Decimal? @map("max_daily_mg") @db.Decimal(10, 2)
