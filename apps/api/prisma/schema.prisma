  VIEW_SUMMARY
  VIEW_RECORD
  WRITE
  EXPORT
  PRINT
  BREAK_GLASS
}

enum AccessReason {
  ACTIVE_CONSULTATION
  FOLLOW_UP
  EMERGENCY
  REFERRAL_REVIEW
