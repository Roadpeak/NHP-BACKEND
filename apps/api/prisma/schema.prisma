  CONFIRMED
  ACTIVE
  RESOLVED
  RECURRENCE
  IN_REMISSION
  REFUTED
}

enum SubstanceKind {
  DRUG
  FOOD
  ENVIRONMENT
  OTHER
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  ANAPHYLAXIS
}

enum Certainty {
  SUSPECTED
  CONFIRMED
}

enum Route {
  ORAL
  IV
  IM
  SC
  TOPICAL
  INHALED
  RECTAL
}

enum MedStatus {
  PRESCRIBED
  DISPENSED
  ACTIVE
  COMPLETED
