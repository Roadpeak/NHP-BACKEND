  DENIED_RATE_LIMIT
  DENIED_SELF_ACCESS
}

enum BgReason {
  UNCONSCIOUS
  LIFE_THREATENING
  PATIENT_UNABLE
  GUARDIAN_UNREACHABLE
  MASS_CASUALTY
}

enum ReviewStatus {
  PENDING
  REVIEWED_OK
  FLAGGED
  ESCALATED
}

enum MinRole {
  ANALYST
  REGISTRAR
  SURVEILLANCE
